---
import Layout from "../layouts/Layout.astro";
---

<style is:global>
  h1 {
    font-size: 7.5rem;
    line-height: 0.75;
  }

  p {
    font-size: 1.25rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .links {
    display: grid;
  }

  .links a {
    width: 100%;
    box-sizing: border-box;
  }
</style>

<Layout>
  <h1>404</h1>
  <p>Page not found</p>
  <div class="links">
    <a href="/">Home</a>
    <a onclick="history.back()">Back</a>
  </div>
</Layout>
